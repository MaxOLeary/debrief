{
  "name": "debrief",
  "version": "1.0.0",
  "description": "Local menu-bar meeting recorder: system audio + mic -> Parakeet (sherpa-onnx) -> LLM notes. No accounts, no cloud storage, no telemetry.",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "postinstall": "node scripts/make-icon.js",
    "setup": "bash scripts/setup.sh",
    "fetch-model": "node scripts/fetch-model.js",
    "fetch-llm": "node scripts/fetch-llm.js",
    "selftest": "electron . --selftest=14"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0"
  },
  "devDependencies": {
    "electron": "^43.0.0"
  }
}
