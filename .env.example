# ─── Debrief config ───────────────────────────────────────────────────
# Copy this file to `.env`. Everything is optional: with no keys at all the app
# still records and transcribes locally, it just won't write an AI summary.

# ── Summary ─────────────────────────────────────────────────────────────────
# You do NOT need an account or an API key. By default the summary is written
# by a small open-source model running on this Mac (llama.cpp + Qwen3 4B). The
# engine and model download themselves the first time the app runs, into
# ~/.config/debrief/. Nothing about the meeting ever leaves the machine.
#
# "auto" order: an API key if you typed one in, otherwise the local model,
# otherwise the Claude Code CLI, otherwise no summary at all.
# SUMMARY_PROVIDER=auto            # auto | local | claude-cli | anthropic | openai | groq | none
# LLM_MODEL=qwen3-4b               # qwen3-4b (default) | qwen2.5-3b | llama3.2-3b | /path/to/any.gguf
# LLAMA_SERVER_BIN=                # only if you built llama.cpp yourself
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# SUMMARY_MODEL=                   # override the model for that provider
# CLAUDE_BIN=                      # path to the claude CLI if it isn't found

# ── Transcription ───────────────────────────────────────────────────────────
# auto  = local whisper.cpp if the model file exists, else the API (needs a key)
# local = always whisper.cpp   (fully offline)
# api   = always OpenAI/Groq Whisper
# TRANSCRIBE_BACKEND=auto
# WHISPER_BIN=                     # defaults to the vendored vendor/whisper-cli
# WHISPER_MODEL=~/.config/debrief/models/ggml-medium.bin
# WHISPER_THREADS=8
# WHISPER_LANGUAGE=en
# USE_VAD=1                        # 0 disables voice-activity detection
# VAD_MODEL=                       # defaults to ggml-silero-v5.1.2.bin beside the model

# ── Recording ───────────────────────────────────────────────────────────────
# The app records the microphone only. Capturing what the Mac plays (the far
# side of a call) is off by default because the only way macOS lets an app do
# it is the screen-capture API, and the macOS 26 permission dialog for that is
# genuinely alarming ("bypass the private window picker"). Set 1 to try it.
# SYSTEM_AUDIO=0

# ── Output ──────────────────────────────────────────────────────────────────
# NOTES_DIR=~/Debrief
# TRAY_LABEL=Notes                 # text beside the menu bar icon; empty = icon only
# YOUR_NAME=Max                    # how you're labelled in the transcript
# THEIR_NAME=Them                  # everyone on the far side
# MIC_GAIN=1.0                     # your voice   (left channel)
# SYSTEM_GAIN=1.0                  # everyone else (right channel)
# GLOBAL_SHORTCUT=Command+Shift+R  # empty string disables it

# Which app opens a finished note. Blank = the macOS default for .md, which is
# usually a code editor and shows the raw markdown. Name a reader instead to get
# the formatted version, e.g. Obsidian. The notes folder has to be an Obsidian
# vault for that (a .obsidian/ folder inside it is all that takes).
MARKDOWN_APP=
